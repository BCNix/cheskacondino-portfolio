---
import "../styles/tokens.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Cheska Condino | Lifestyle & travel creator in Victoria, BC",
  description = "Influencer & UGC creator for lifestyle, travel and fashion, based in Victoria, BC.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" href="/logo/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/logo/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <main id="content">
      <slot />
    </main>
  </body>
</html>

<style>
  .skip-link {
    background-color: var(--accent);
    color: var(--on-accent);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 1.25rem;
    border-radius: 999px;
    font-weight: 500;
    text-decoration: none;
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 70;
    transform: translateY(-150%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
