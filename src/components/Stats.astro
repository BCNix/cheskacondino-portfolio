---
import type { ReachStat } from "../types";

interface Props {
  reach: ReachStat[];
  asOf: string;
  source: string;
}

const { reach, asOf, source } = Astro.props;
---

<section class="stats" aria-labelledby="stats-h">
  <div class="container">
    <h2 id="stats-h" class="sr-only">By the numbers</h2>
    <dl class="stats-grid">
      {
        reach.map((stat) => (
          <div class="stat">
            <dt class="stat-label">{stat.label}</dt>
            {stat.value === null ? (
              <dd class="stat-value is-placeholder">{stat.placeholder}</dd>
            ) : (
              <dd class="stat-value">
                <span class="sr-only">
                  {stat.value}
                  {stat.unit}
                </span>
                <span aria-hidden="true">
                  <span data-count={stat.value}>{stat.value}</span>
                  {stat.unit && <span class="stat-unit">{stat.unit}</span>}
                </span>
              </dd>
            )}
          </div>
        ))
      }
    </dl>
    <p class="stats-note">As of {asOf}, from {source}</p>
  </div>
</section>

<style>
  .stats {
    background: var(--surface-2);
    padding: 48px 0 40px;
  }

  .stats .container {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .stats-grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px 20px;
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
  }

  .stat-value {
    margin: 0;
    font-family: "Bodoni Moda", serif;
    font-size: 44px;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .stat-unit {
    font-style: italic;
    color: var(--accent);
    margin-left: 2px;
  }

  .is-placeholder {
    color: var(--muted);
  }

  .stat-label {
    font-size: 14px;
    color: var(--muted);
  }

  .stats-note {
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
  }

  @media (min-width: 600px) and (max-width: 767px) {
    .stat {
      align-items: center;
      text-align: center;
    }
    .stats-note {
      text-align: center;
    }
  }

  @media (min-width: 768px) {
    .stats {
      padding: 88px 0 72px;
    }

    .stats .container {
      gap: 48px;
    }

    .stat {
      gap: 14px;
    }

    .stat-value {
      font-size: 68px;
    }

    .stat-label {
      font-size: 16px;
    }

    .stats-note {
      padding-top: 20px;
    }
  }

  @media (min-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 48px;
    }

    .stat-value {
      font-size: clamp(56px, 5.6vw, 68px);
    }
  }
</style>
