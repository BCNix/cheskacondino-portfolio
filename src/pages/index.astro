---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import { getEntry } from "astro:content";

const socials = await getEntry("socials", "socials");

if (!socials) {
  throw new Error("socials.json failed to load");
}
---

<BaseLayout>
  <Nav slot="header" />
  <Hero tiktok={socials.data.tiktok} instagram={socials.data.instagram} />
</BaseLayout>
